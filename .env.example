# Copy to .env (never commit .env) or set these in your shell / Azure Container App.
# Everything is optional: without them Touchline runs offline with template lines and the browser voice.
# Check the model with: python -m touchline.check

# ---- The language model: Azure OpenAI in Microsoft Foundry --------------------------------------
# Needs a Pay-As-You-Go subscription (free-trial subscriptions have no model quota; upgrading keeps the credit).
# Endpoint and KEY 1 are on the resource's "Keys and Endpoint" page; the deployment name is set in Foundry.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: use the model only for the big moments, to save calls.
# TOUCHLINE_LLM_MOMENTS=prematch,half_time,full_time,substitution

# ---- Neural voice: Azure AI Speech (the Free F0 tier works on a free-trial subscription) ------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-GB-RyanNeural
